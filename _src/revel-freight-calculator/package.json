{
  "name": "revel-freight-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --base=/revel-freight-calculator/",
    "preview": "vite preview --base=/revel-freight-calculator/",
    "test": "tsx --test src/lib/*.test.ts",
    "import:master-data": "tsx scripts/import-master-data.ts",
    "import:zones": "tsx scripts/import-zones.ts",
    "build:postcodes": "tsx scripts/build-postcodes.ts",
    "import:website": "tsx scripts/import-website.ts",
    "build:artifact": "tsx scripts/build-artifact.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
